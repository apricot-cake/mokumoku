{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // 生成物（.output・.wxt）は .gitignore にあるので、ここでは繰り返さない。
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    // インデント・改行・末尾改行は .editorconfig で宣言し、エディタと揃える。
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
